#: ojs/templates/admin/ojs/journal/change_list_object_tools.html:13
#: ojs/templates/admin/ojs/register_journals.html:4
#: ojs/templates/admin/ojs/register_journals.html:27
msgid "Register journals"
msgstr "Registrer journaler"

#: ojs/templates/admin/ojs/register_journals.html:29
msgid ""
"\n"
"            Register the journals from a particular OJS instance. Insert first the\n"
"            URL and Key of the OJS installation. Decide then for each journal you\n"
"            want to connect with Fidus Writer which user should be registered as\n"
"            their editor.\n"
"            "
msgstr ""
"\n"
"            Registrer journalerne fra en bestemt OJS-instans. Indsæt først\n"
"            URL og nøgle til OJS-installationen. Beslut så for hver dagbog du\n"
"            ønsker at forbinde med Fidus Writer, hvilken bruger skal være registreret som\n"
"            deres redaktør.\n"
"            "

#: ojs/templates/admin/ojs/register_journals.html:37
msgid "URL"
msgstr "URL"

#: ojs/templates/admin/ojs/register_journals.html:38
msgid "Key"
msgstr "Nøgle"

#: ojs/templates/admin/ojs/register_journals.html:39
msgid "Query available journals"
msgstr "Forespørg på tilgængelige tidsskrifter"
