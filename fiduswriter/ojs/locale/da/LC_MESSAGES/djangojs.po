msgstr "Artikel indsendt"

#: ojs/static/js/modules/ojs/submit_doc.js:53
msgid "Article could not be submitted."
msgstr "Artiklen kunne ikke indsendes."

#: ojs/static/js/modules/ojs/templates.js:12
msgid "Submission information"
msgstr "Indsendelsesoplysninger"

#: ojs/static/js/modules/ojs/templates.js:16
msgid "Journal"
msgstr "Tidsskrift"

#: ojs/static/js/modules/ojs/templates.js:34
msgid "Abstract"
msgstr "Abstrakt"

#: ojs/static/js/modules/ojs/templates.js:41
