#: ojs/static/js/modules/ojs/templates.js:45
msgid "First name"
msgstr "Fornavn"

#: ojs/static/js/modules/ojs/templates.js:51
msgid "Last name"
msgstr "Efternavn"

#: ojs/static/js/modules/ojs/templates.js:56
msgid "Affiliation"
msgstr "Tilknytning"

#: ojs/static/js/modules/ojs/templates.js:60
msgid "Webpage"
msgstr "webside"

#: ojs/static/js/modules/ojs/templates.js:67
msgid ""
"By pressing the submit button your resubmission will be sent to the journal"
msgstr ""
"Ved at trykke på send-knappen vil din genindsendelse blive sendt til "
"journalen"

#: ojs/static/js/modules/ojs/templates.js:68
#: ojs/static/js/modules/ojs/templates.js:85
