#: ojs/static/js/modules/ojs/admin.js:57
msgid "Provide a URL for the OJS server and the key to access it."
msgstr "Gebe eine URL für einen OJS Server und den entsprechenden Key an."

#: ojs/static/js/modules/ojs/admin.js:96
msgid "Editor"
msgstr "Editor"

#: ojs/static/js/modules/ojs/admin.js:100
msgid "Register"
msgstr "Registrieren"

#: ojs/static/js/modules/ojs/admin.js:109
msgid "Could not connect to OJS server."
msgstr "Verbindung zum OJS-Server konnte nicht hergestellt werden."

#: ojs/static/js/modules/ojs/admin.js:126
msgid "Editor and journal name need to be filled out."
msgstr "Editor und Journal Name sind Pflichtfelder."

#: ojs/static/js/modules/ojs/admin.js:134
msgid "Editor needs to be the ID number of the editor user."
msgstr "Editor muss die ID Nummer des Editor Users sein."

#: ojs/static/js/modules/ojs/admin.js:148
msgid "Journal saved."
msgstr "Zeitschrift gespeichert."

#: ojs/static/js/modules/ojs/admin.js:152
msgid "Journal already present on server."
msgstr "Zeitschrift schon auf dem Server vorhanden."

#: ojs/static/js/modules/ojs/admin.js:161
msgid "Could not save journal. Please check form."
msgstr ""
"Konnte die Zeitschrift nicht abspeichern. Bitte untersuche das Formular."

#: ojs/static/js/modules/ojs/editor.js:40
msgid "Could not obtain submission info."
msgstr "Übermittlungsinformationen konnten nicht abgerufen werden."

#: ojs/static/js/modules/ojs/editor.js:72
#: ojs/static/js/modules/ojs/editor.js:74
msgid "Submit to journal"
msgstr "Sende an Journal"

#: ojs/static/js/modules/ojs/editor.js:136
msgid "Submit"
msgstr "Einschicken"

#: ojs/static/js/modules/ojs/editor.js:165
msgid "Firstname, lastname and abstract are obligatory fields!"
msgstr "Vorname, Nachname und Zusammenfassung sind Pflichtfelder!"

#: ojs/static/js/modules/ojs/editor.js:202
msgid "Complete missing information and choose journal"
msgstr "Vervollständige die Detalien und wähle Journal aus"

#: ojs/static/js/modules/ojs/editor.js:225
#: ojs/static/js/modules/ojs/editor.js:249
#: ojs/static/js/modules/ojs/editor.js:323
msgid "Send"
msgstr "Abschicken"

#: ojs/static/js/modules/ojs/editor.js:239
#: ojs/static/js/modules/ojs/editor.js:263
msgid "Submit revision"
msgstr "Überarbeitung einreichen"

#: ojs/static/js/modules/ojs/editor.js:274
msgid "Editors are informed."
msgstr "Die Redaktion wird informiert."

#: ojs/static/js/modules/ojs/editor.js:278
msgid "Updates could not be submitted."
msgstr "Aktualisierungen konnten nicht übermittelt werden."

#: ojs/static/js/modules/ojs/editor.js:288
msgid "Resubmission successful"
msgstr "Erneute Einreichung erfolgreich"

#: ojs/static/js/modules/ojs/editor.js:292
#: ojs/static/js/modules/ojs/editor.js:379
msgid "Review could not be submitted."
msgstr "Review konnte nicht eingereicht werden."

#: ojs/static/js/modules/ojs/editor.js:340
msgid "Leave your messages for editor and authors"
msgstr "Hinterlasse deine Nachricht für den Editor und die Autoren"

#: ojs/static/js/modules/ojs/editor.js:363
msgid "Fill out all fields before submitting!"
msgstr "Fülle alle Felder vor dem einschicken aus!"

#: ojs/static/js/modules/ojs/editor.js:375
msgid "Review submitted"
msgstr "Review eingeschickt"

#: ojs/static/js/modules/ojs/submit_doc.js:51
