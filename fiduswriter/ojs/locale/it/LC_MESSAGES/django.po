msgid "Register journals"
msgstr "Registrare le riviste"

#: ojs/templates/admin/ojs/register_journals.html:29
msgid ""
"\n"
"            Register the journals from a particular OJS instance. Insert first the\n"
"            URL and Key of the OJS installation. Decide then for each journal you\n"
"            want to connect with Fidus Writer which user should be registered as\n"
"            their editor.\n"
"            "
msgstr ""
"\n"
"            Registrare le riviste da una particolare istanza OJS. Inserisci prima il\n"
"            URL e chiave dell'installazione di OJS. Decidi quindi per ogni diario che desideri\n"
"            desidera connettersi con Fidus Writer con quale utente deve essere registrato\n"
"            il loro editore.\n"
"                        "

#: ojs/templates/admin/ojs/register_journals.html:37
msgid "URL"
msgstr "URL"

#: ojs/templates/admin/ojs/register_journals.html:38
msgid "Key"
msgstr "Chiave"

#: ojs/templates/admin/ojs/register_journals.html:39
msgid "Query available journals"
msgstr "Cerca riviste disponibili"
