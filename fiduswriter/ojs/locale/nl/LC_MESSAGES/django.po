#: ojs/templates/admin/ojs/journal/change_list_object_tools.html:13
#: ojs/templates/admin/ojs/register_journals.html:4
#: ojs/templates/admin/ojs/register_journals.html:29
msgid "Register journals"
msgstr "Tijdschriften registreren"

#: ojs/templates/admin/ojs/register_journals.html:31
msgid ""
"\n"
"            Register the journals from a particular OJS instance. Insert first the\n"
"            URL and Key of the OJS installation. Decide then for each journal you\n"
"            want to connect with Fidus Writer which user should be registered as\n"
"            their editor.\n"
"            "
msgstr ""
"\n"
"            Registreer de tijdschriften van een bepaald OJS-exemplaar. Plaats eerst de\n"
"            URL en sleutel van de OJS-installatie. Bepaal dan voor elk journaal je\n"
"            verbinding wilt maken met Fidus Writer, onder welke gebruiker moet u zich registreren\n"
"            hun redacteur.\n"
"            "

#: ojs/templates/admin/ojs/register_journals.html:39
msgid "URL"
msgstr "URL"

#: ojs/templates/admin/ojs/register_journals.html:40
msgid "Key"
msgstr "Sleutel"

#: ojs/templates/admin/ojs/register_journals.html:41
msgid "Query available journals"
msgstr "Beschikbare tijdschriften opvragen"
