msgstr "Send inn for ny vurdering"

#: ojs/static/js/modules/ojs/templates.js:81
msgid "Resubmit Elsewhere"
msgstr "Send inn på nytt et annet sted"

#: ojs/static/js/modules/ojs/templates.js:82
msgid "Decline Submission"
msgstr "Avslå innsending"

#: ojs/static/js/modules/ojs/templates.js:83
